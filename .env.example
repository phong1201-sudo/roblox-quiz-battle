# ── MongoDB Atlas Cloud Storage Configuration ────────────────────────────────
# 1. Sign up for free at https://www.mongodb.com/cloud/atlas
# 2. Create a free M0 cluster (Shared)
# 3. Create a Database User with username & password
# 4. Under "Network Access", allow IP: 0.0.0.0/0 (allow access from anywhere for Render)
# 5. In Render Dashboard -> Your Web Service -> Environment:
#    Add environment variable:
#    MONGODB_URI = mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/roblox_quiz_battle?retryWrites=true&w=majority

MONGODB_URI=
PORT=3000
